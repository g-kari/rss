{
  "name": "rss-reader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-release-notes.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-release-notes.mjs",
    "build": "next build",
    "preview": "wrangler dev",
    "build:cf": "npx @opennextjs/cloudflare build && node scripts/add-scheduled-handler.mjs",
    "deploy": "node scripts/stamp-sw-version.mjs && npm run build:cf && wrangler deploy",
    "pretypecheck": "node scripts/sync-release-notes.mjs",
    "typecheck": "tsc --noEmit",
    "precheck": "node scripts/sync-release-notes.mjs",
    "check": "vp check",
    "precheck:fix": "node scripts/sync-release-notes.mjs",
    "check:fix": "vp check --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.13.24",
    "fast-xml-parser": "^5.7.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "linkedom": "^0.18.12",
    "marked": "^18.0.3",
    "masonic": "^4.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@opennextjs/cloudflare": "^1.19.8",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260502.1",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.9.0",
    "next": "~16.2.4",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plus": "^0.1.20",
    "wrangler": "^4.90.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "yaml": ">=2.8.3",
      "brace-expansion": ">=5.0.5",
      "minimatch": ">=10.0.0",
      "glob": ">=10",
      "path-to-regexp": "^6.3.0",
      "vite": ">=8.0.5",
      "postcss": ">=8.5.13",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7"
    }
  }
}

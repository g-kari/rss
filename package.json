{
  "name": "rss-reader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "gen:coverage-map": "node scripts/generate-test-coverage-map.mjs",
    "predev": "node scripts/sync-release-notes.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-release-notes.mjs",
    "build": "next build",
    "preview": "wrangler dev",
    "build:cf": "npx @opennextjs/cloudflare build && node scripts/remove-bundled-wasm.mjs && node scripts/add-scheduled-handler.mjs",
    "deploy": "node scripts/stamp-sw-version.mjs && npm run build:cf && wrangler deploy",
    "pretypecheck": "node scripts/sync-release-notes.mjs",
    "typecheck": "tsc --noEmit",
    "precheck": "node scripts/sync-release-notes.mjs",
    "check": "vp check",
    "precheck:fix": "node scripts/sync-release-notes.mjs",
    "check:fix": "vp check --fix",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "upload:piper-wasm": "node scripts/upload-piper-wasm.mjs",
    "upload:piper-voices": "node scripts/upload-piper-voices.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.14.10",
    "fast-xml-parser": "^5.11.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "linkedom": "^0.18.13",
    "marked": "^18.0.11",
    "onnxruntime-web": "^1.27.0",
    "piper-plus": "^0.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260702.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.6",
    "next": "~16.3.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plus": "^0.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.107.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "yaml": ">=2.8.3",
      "brace-expansion": ">=5.0.5",
      "minimatch": ">=10.0.0",
      "glob": ">=10",
      "path-to-regexp": "^6.3.0",
      "vite": ">=8.0.5",
      "postcss": ">=8.5.13",
      "fast-xml-parser": ">=5.7.0",
      "fast-xml-builder": ">=1.1.7",
      "ws": ">=8.20.1",
      "protobufjs": "^7.5.8",
      "sharp": ">=0.35.0"
    },
    "patchedDependencies": {
      "piper-plus": "patches/piper-plus.patch"
    }
  }
}

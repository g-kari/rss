{
  // Template only. Fill the real ID, approve maintenance, and pause feed writers.
  // No entrypoint is provided: this configuration must not be deployed.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "rss-reader-search-maintenance",
  "compatibility_date": "2026-05-01",
  "r2_buckets": [{ "binding": "RSS_DATA", "bucket_name": "rss-reader-data", "remote": true }],
  "d1_databases": [
    {
      "binding": "ARTICLE_SEARCH",
      "database_name": "rss-reader-search",
      "database_id": "REPLACE_WITH_OPERATOR_APPROVED_DATABASE_ID",
      "migrations_dir": "../migrations/article-search",
      "remote": true,
    },
  ],
}
